{
    "name": "aymardkouakou/orange-api-php",
    "description": "Orange Api PHP integration",
    "type": "library",
    "license": "MIT",
    "version": "3.6.0",
    "autoload": {
        "psr-4": {
            "AymardKouakou\\OrangeApiPhp\\": "src/",
            "AymardKouakou\\OrangeApiPhp\\Tests\\": "tests/"
        },
        "classmap": [
            "src/"
        ]
    },
    "authors": [
        {
            "name": "Aymard Kouakou",
            "email": "ay.kouakou@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "symfony/filesystem": "^7.2",
        "monolog/monolog": "^2.2",
        "cakephp/cakephp": "5.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.5 || ^11.1.3",
        "vlucas/phpdotenv": "^5.6"
    }
}
